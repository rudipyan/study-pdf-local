{
	"name": "study-pdf-local",
	"version": "0.5.0",
	"description": "Highlight PDFs with custom colors, edit comments, and export annotations and quotations.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"lint": "eslint src"
	},
	"keywords": [],
	"license": "MIT",
	"dependencies": {
		"@cantoo/pdf-lib": "^2.8.1"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"esbuild": "0.28.1",
		"eslint": "^10.7.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"pdfjs-dist": "^6.2.108",
		"tsx": "^4.23.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"author": "Rudi Sayat Pulatyan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rudipyan/study-pdf-local.git"
	},
	"homepage": "https://github.com/rudipyan/study-pdf-local",
	"bugs": {
		"url": "https://github.com/rudipyan/study-pdf-local/issues"
	}
}
